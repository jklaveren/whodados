# =================================================================
# Variaveis de ambiente para a API FastAPI
# Copie para .env e preencha os valores
# LOCAL: whodados/backend/.env.example
# =================================================================

# Connection string do Supabase (PostgreSQL)
# Formato: postgresql://postgres:[SENHA]@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# Ambiente: development | production
APP_ENV=development
DEBUG=false

# Origens CORS permitidas (separadas por virgula)
# Em producao: URL do frontend na Vercel
CORS_ORIGINS=http://localhost:3000

# Fonte dos dados: "database" (Supabase) ou "files" (CSVs)
DATA_SOURCE=database

# Tempo de cache em segundos (padrao: 300 = 5 min)
API_CACHE_TTL_SECONDS=300

# =================================================================
# JWT - CHAVE OBRIGATORIAMENTE FORTE EM PRODUCAO!
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# =================================================================
SECRET_KEY=change-me-in-production-use-strong-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Bcrypt rounds para hash de senhas (12 = padrao seguro)
BCRYPT_ROUNDS=12

# =================================================================
# SMTP (para envio de emails)
# =================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=noreply@whodados.com
EMAIL_FROM_NAME=WhoDados

# URL publica desta API (em producao: a URL do Render, ex. https://whodados-api.onrender.com)
# Usada para montar o link do card/imagem do template dentro do email enviado.
API_PUBLIC_URL=http://localhost:8000
# Botao 'Conectar Gmail': cliente OAuth do tipo Aplicativo da Web no Google
# Cloud, com <API_PUBLIC_URL>/api/v1/gmail/callback como URI de retorno.
GMAIL_WEB_CLIENT_ID=
GMAIL_WEB_CLIENT_SECRET=
# Para onde o retorno do Google devolve a pessoa.
FRONTEND_URL=http://localhost:3000

# =================================================================
# SEGURANCA - RATE LIMITING
# =================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# =================================================================
# SEGURANCA - AUDITORIA
# =================================================================
AUDIT_ENABLED=true

# =================================================================
# SEGURANCA - LOGIN BRUTE FORCE PROTECTION
# =================================================================
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# =================================================================
# LOG
# =================================================================
LOG_LEVEL=INFO
LOG_FORMAT=text

# Chave da API da Anthropic (para consulta em linguagem natural /empresas/consulta-natural)
ANTHROPIC_API_KEY=

# =================================================================
# WEB PUSH (PWA - avisos no celular, sem FCM/APNs)
# Gere um par novo com: python -c "from backend.push import gerar_vapid; print(gerar_vapid())"
# A publica o frontend busca sozinho via GET /push/vapid-public-key.
# =================================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@whodados.com
