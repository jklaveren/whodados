# =================================================================
# Variaveis de ambiente para o Next.js (frontend)
# Copie este arquivo para .env.local e preencha os valores
# LOCAL: whodados/frontend/.env.example
# =================================================================

# URL da API FastAPI (backend)
# Em desenvolvimento: http://localhost:8000
# Em producao: URL do Render (ex: https://whodados-api.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:8000
